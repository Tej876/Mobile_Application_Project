# QueueLess Backend Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/queueless_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/queueless_db

# Firebase Admin SDK Configuration
# Optional: path to your downloaded Firebase Service Account JSON
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
# Or Firebase Project ID for Application Default Credentials
FIREBASE_PROJECT_ID=queueless-12345

# Admin Secret Key for bootstrapping the first admin user
ADMIN_BOOTSTRAP_SECRET=queueless_admin_bootstrap_secret_2026

# EmailJS credentials (if dispatched from backend)
EMAILJS_SERVICE_ID=service_iy98qhl
EMAILJS_TEMPLATE_ID=template_spgddsr
EMAILJS_PUBLIC_KEY=r7ycTTdlaXk_DEniC
